Checks: >
    -*,
    bugprone-*,
    clang-analyzer-*,
    clang-diagnostic-*,
    concurrency-*,
    cppcoreguidelines-*,
    google-*,
    llvm-*,
    misc-*,
    modernize-*,
    mpi-*,
    openmp-*,
    performance-*,
    readability-*,

    -google-readability-todo,
    -modernize-use-trailing-return-type,

CheckOptions:
  - key: misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic
    value: 'true'

FormatStyle: file

ImplementationFileExtensions:
    - 'c'
    - 'cc'
    - 'cpp'
    - 'cxx'
    - 'ino'
